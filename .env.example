# Copiá este archivo como .env y completá los valores.
# Clave para firmar las sesiones (poné cualquier texto largo y secreto)
SECRET_KEY=cambiar-por-un-texto-largo-y-secreto
# PIN inicial del admin (solo se usa la primera vez que arranca la app)
ADMIN_NOMBRE=Vengil
ADMIN_PIN=1234
# Base de datos: vacío = archivo local SQLite. En Render se completa sola con Postgres.
DATABASE_URL=
# Horas que dura una sesión antes de pedir el PIN otra vez
SESION_HORAS=12
# Cierre diario por mail
CIERRE_AUTOMATICO=1
CIERRE_HORA=19:00
CIERRE_DIAS=mon-sat
MAIL_TO=gerencia@magontex.com.ar
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- ParkaHub (datos de Mercado Libre / Tienda Nube, solo lectura) ---
# Service token de Cloudflare Access que crea Martin. También se cargan desde la app: Conexiones.
PARKAHUB_URL=https://parkahub.pages.dev
PARKAHUB_CLIENT_ID=
PARKAHUB_CLIENT_SECRET=
# --- Asistente (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
